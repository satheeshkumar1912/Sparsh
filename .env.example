DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=sparshinclusive.edu,www.sparshinclusive.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://sparshinclusive.edu,https://www.sparshinclusive.edu

# PostgreSQL (production). Leave blank to use SQLite for local development.
DB_NAME=sparsh
DB_USER=sparsh
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5432

# Titan Mail SMTP (GoDaddy). Port 465 uses SSL. Leave EMAIL_USE_TLS false.
# DEFAULT_FROM_EMAIL must be the Titan mailbox, or an alias of that mailbox.
# Copy these into the project-root .env (never commit that file) or into the
# GoDaddy Python app environment variables. Do not put the real password here.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=465
EMAIL_HOST_USER=your-mailbox@yourdomain.com
EMAIL_HOST_PASSWORD=your-mailbox-password
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=your-mailbox@yourdomain.com

# Contact & admissions notifications (the inbox that receives form alerts)
CONTACT_EMAIL=enquiry@sparshinclusiveeducation.com
ADMISSIONS_NOTIFY_EMAIL=enquiry@sparshinclusiveeducation.com
WHATSAPP_NUMBER=919876543210

# Optional reCAPTCHA (leave blank to use honeypot CAPTCHA)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
